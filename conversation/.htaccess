Options -Indexes

RewriteEngine On
RewriteBase /conversation/

# Public CSS / JS / images
RewriteRule ^assets/(.*)$ public/assets/$1 [L]

# Uploaded avatars
RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

# After rewriting an asset into /public, allow the real file through.
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else goes to the application router.
RewriteRule ^ router.php [QSA,L]
