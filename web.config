<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <directoryBrowse enabled="true" />
        <staticContent>
            <mimeMap fileExtension=".php" mimeType="text/html" />
        </staticContent>
        <handlers accessPolicy="Read, Execute, Script">
            <add name="php" path="*.php" verb="*" type="System.Web.UI.Page, System.Web, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b03f5f7f11d50a3a" resourceType="File" preCondition="integratedMode" />
        </handlers>
    </system.webServer>
</configuration>
