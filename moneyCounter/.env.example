# Copy to .env. Existing process environment variables take precedence.
MC_DB=instance/cash.sqlite3
MC_TIMEZONE=America/Denver
MC_HOST=127.0.0.1
MC_PORT=8000
MC_BASE_PATH=
MC_SECURE_COOKIES=0
MC_CORS_ORIGINS=
MC_FRAME_ORIGINS=
MC_CROSS_SITE_COOKIE=0
MC_ENABLE_API_TOKENS=1

# Optional off-process MySQL backup. Use a dedicated database and account.
# MC_MYSQL_HOST=127.0.0.1
# MC_MYSQL_PORT=3306
# MC_MYSQL_DATABASE=moneycounter_backup
# MC_MYSQL_USER=moneycounter
# MC_MYSQL_PASSWORD=
# MC_MYSQL_CA=/path/to/ca.pem
# MC_MYSQL_SLOT=main
