# Never expose Git repositories through the web server.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(?:/|$) - [F,L,NC]
</IfModule>

ErrorDocument 400 /.error/.error.php
ErrorDocument 401 /.error/.error.php
ErrorDocument 403 /.error/.error.php
ErrorDocument 404 /.error/.error.php
ErrorDocument 405 /.error/.error.php
ErrorDocument 408 /.error/.error.php
ErrorDocument 414 /.error/.error.php
ErrorDocument 500 /.error/.error.php
ErrorDocument 502 /.error/.error.php
ErrorDocument 504 /.error/.error.php

# .htaccess main domain to subdirectory redirect
AddType application/x-httpd-php .aspx

RewriteEngine on
# Change example.com to be your main domain.
RewriteCond %{HTTP_HOST} ^(www.)smokeemgirl.com$
# Change 'subdirectory' to be the directory you will use for your main domain.
RewriteCond %{REQUEST_URI} !^/conversation/
# Don't change the following two lines.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# Change 'subdirectory' to be the directory you will use for your main domain.
RewriteRule ^(.*)$ /conversation/$1
# Change example.com to be your main domain again.
# Change 'subdirectory' to be the directory you will use for your main domain
# followed by / then the main file for your site, index.php, index.html, etc.
RewriteCond %{HTTP_HOST} ^(www.)?smokeemgirl.com$
RewriteRule ^(/)?$ conversation/ [L]

php_flag allow_url_include on
DirectoryIndex index.php index.htm index.html index.shtml default.php

RewriteEngine On
RewriteRule ^rankings/?$ /stock_trade/rankings/ [R=302,L,QSA]
RewriteRule ^index$ index.php [L]


#theFixZone
# Route /fixZone to a specific File
RewriteRule /fixZone /xampp/htdocs/fixZone/public/index.php [L]

# Redirect fixZone subdomain to folder
RewriteCond %{HTTP_HOST} ^fixZone\.mrjohndowe\.com$ [NC]
RewriteRule ^(.*)$ /fixZone/$1 [L]
